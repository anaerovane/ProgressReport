#!/bin/bash
#PBS -q auto_free
#PBS -N attn_a40_64_add
#PBS -j oe
#PBS -l select=1:ncpus=4:mpiprocs=1:ngpus=1:node_pool=cpu_node:mem=16GB
#PBS -l walltime=01:00:00
set -euo pipefail
SRC="$HOME/ring_attention_followup_20261029"
OUT="$HOME/ring_attention_missing5_20261030/results"
cd "$SRC"
module load gcc/13.1.0
module load cuda12.4/toolkit/12.4.1
nvcc -O3 -std=c++17 -arch=sm_86 src/fp64/attention_cuda.cu -lcublas -o "$OUT/attention_cuda_fp64"
"$OUT/attention_cuda_fp64" --n 257 --d 31 --dv 19 --bq 128 --bk 256 --validate --repeats 3 > "$OUT/a40_fp64_check257.txt"
for n in 32768 65536; do
  "$OUT/attention_cuda_fp64" --n "$n" --d 64 --dv 64 --bq 128 --bk 256 --repeats 3 > "$OUT/a40_fp64_n${n}.txt"
done
echo A40_FP64_ADDITIONAL_RUNS=PASS
