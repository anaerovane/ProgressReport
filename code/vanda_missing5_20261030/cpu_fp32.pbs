#!/bin/bash
#PBS -q auto_free
#PBS -N attn_cpu32_add
#PBS -j oe
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=8gb
#PBS -l walltime=01:00:00
set -euo pipefail
SRC="$HOME/ring_attention_followup_20261029"
OUT="$HOME/ring_attention_missing5_20261030/results"
cd "$SRC"
module load gcc/13.1.0
g++ -O3 -std=c++17 src/attention_serial_fp32.cpp -o "$OUT/attention_serial_fp32"
"$OUT/attention_serial_fp32" --n 257 --d 31 --dv 19 --repeats 1 --check > "$OUT/cpu_fp32_check257.txt"
"$OUT/attention_serial_fp32" --n 65536 --d 64 --dv 64 --repeats 3 > "$OUT/cpu_fp32_n65536.txt"
echo CPU_FP32_ADDITIONAL_RUNS=PASS
